{
    "extends": "@becklyn/tsconfig/base.json",
    "compilerOptions": {
        "module": "commonjs",
        "moduleResolution": "bundler",
        "outDir": "./dist",
        "emitDeclarationOnly": true,
        "noEmit": false,
        "paths": { "@/migrations/*": ["./migrations/*"] }
    },
    "include": ["."],
    "exclude": ["node_modules", "dist", "test"]
}
